# Postgres connection string for the system of record.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bdr

# Optional: route the audit browser through a proxy (falls back to HTTPS_PROXY).
# AUDIT_PROXY=http://user:pass@host:port

# Optional: use a specific Chromium binary instead of Playwright's bundled one.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chromium
